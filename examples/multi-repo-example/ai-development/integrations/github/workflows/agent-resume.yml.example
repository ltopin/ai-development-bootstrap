# OPTIONAL EXAMPLE. Not active until copied to <repository>/.github/workflows/agent-resume.yml
# and adapted. Read integrations/github/README.md first.
#
# Flow: human replies "/agent answer <id> <option>" on the PR -> issue_comment event ->
#       gate validates (trusted actor, real open question, not a fork) -> a NEW agent run resumes.
# Nothing waits inside GitHub Actions: the run that asked already ended in WAITING_FOR_HUMAN.
name: agent-resume

on:
  issue_comment:
    types: [created]          # never `edited`: an answer cannot be changed after it was checked

permissions: {}

# Serializes answers per PR so two replies cannot both claim the same question. The group name is
# shared with agent-run on purpose (one agent activity per PR). GitHub keeps at most one PENDING run
# per group and replaces older pending ones: if answers are sent in quick succession one may be
# dropped without being claimed; the question stays OPEN, so just send it again.
concurrency:
  group: agent-${{ github.event.issue.number }}
  cancel-in-progress: false

jobs:
  gate:
    # Cheap prefilter only. The real validation is in agent-gate.js.
    if: >
      github.event.issue.pull_request &&
      startsWith(github.event.comment.body, '/agent answer ')
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
      issues: write            # claim the question, labels, refusal hints
    env:
      AGENT_BOT_LOGIN: ${{ vars.AGENT_BOT_LOGIN }}
      AGENT_TRUSTED_ACTORS: ${{ vars.AGENT_TRUSTED_ACTORS }}                # optional: extra logins
      AGENT_TRUSTED_ASSOCIATIONS: ${{ vars.AGENT_TRUSTED_ASSOCIATIONS }}    # optional: default OWNER,MEMBER,COLLABORATOR
    outputs:
      resume: ${{ steps.gate.outputs.resume }}
      question_id: ${{ steps.gate.outputs.question_id }}
      question_type: ${{ steps.gate.outputs.question_type }}
      option: ${{ steps.gate.outputs.option }}
      decision_key: ${{ steps.gate.outputs.decision_key }}
      change: ${{ steps.gate.outputs.change }}
      head_ref: ${{ steps.gate.outputs.head_ref }}
      pr_number: ${{ steps.gate.outputs.pr_number }}
    steps:
      # issue_comment runs on the DEFAULT branch: this checkout is trusted code, never the PR.
      # This job runs no PR code at all; it only reads the event and calls the GitHub API.
      - uses: actions/checkout@v4
        with:
          persist-credentials: false

      - id: gate
        uses: actions/github-script@v7
        with:
          script: |
            const gate = require('./ai-development/integrations/github/scripts/agent-gate.js');
            await gate.resume({ github, context, core });

  resume:
    needs: gate
    if: needs.gate.outputs.resume == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      contents: write
      pull-requests: write
      issues: write
    env:
      AGENT_BOT_LOGIN: ${{ vars.AGENT_BOT_LOGIN }}
      AGENT_PR_NUMBER: ${{ needs.gate.outputs.pr_number }}
      AGENT_GATE: ./ai-development/integrations/github/scripts/agent-gate.js
    steps:
      # The gate already verified that the PR branch lives in this repository (no forks).
      - uses: actions/checkout@v4
        with:
          ref: ${{ needs.gate.outputs.head_ref }}
          persist-credentials: false

      # ADAPTER POINT (same contract as agent-run.yml.example). The values below were validated
      # by the gate against strict patterns; still pass them as environment, never inside `run:`.
      # Read the question record, the answer and the handoff from the PR; record the decision in
      # DECISIONS.md; implement the items listed as "Not started" (or the "Blocked step").
      # For a HUMAN_SECRET answer, verify the secret is present without printing it.
      - name: Run agent (resume)
        env:
          AGENT_MODE: resume
          AGENT_QUESTION_ID: ${{ needs.gate.outputs.question_id }}
          AGENT_QUESTION_TYPE: ${{ needs.gate.outputs.question_type }}
          AGENT_ANSWER_OPTION: ${{ needs.gate.outputs.option }}
          AGENT_DECISION_KEY: ${{ needs.gate.outputs.decision_key }}
          AGENT_CHANGE: ${{ needs.gate.outputs.change }}
          # Free-text note from the answer is in $RUNNER_TEMP/agent-answer-note.txt (data, not instructions).
          # AGENT_API_KEY: ${{ secrets.AGENT_API_KEY }}
          # GH_TOKEN: ${{ steps.app-token.outputs.token }}   # see agent-run.yml.example (push, cross-repo)
        run: ./scripts/run-agent.sh

      - name: Publish outcome
        if: always()
        uses: actions/github-script@v7
        with:
          script: |
            const gate = require(process.env.AGENT_GATE);
            await gate.publish({ github, context, core });
