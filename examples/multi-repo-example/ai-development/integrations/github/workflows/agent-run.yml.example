# OPTIONAL EXAMPLE. Not active until copied to <repository>/.github/workflows/agent-run.yml
# and adapted. Read integrations/github/README.md first (permissions, secrets, cross-repo access).
#
# Flow: pull request -> agent (analysis, implementation, validation) -> PR updated -> CI
#       or -> WAITING_FOR_HUMAN (question comment + label); this run ends, nothing stays blocked.
#
# Adjust: AGENT_GATE path, the "Run agent" step, and the repository variables listed in the README.
name: agent-run

on:
  pull_request:
    types: [opened, reopened, synchronize]

# Deny by default; the job grants only what it needs.
permissions: {}

# One run per PR at a time. Never cancel a run in progress: it may be mid-commit.
concurrency:
  group: agent-${{ github.event.pull_request.number }}
  cancel-in-progress: false

jobs:
  agent:
    # - same-repository branches only: forks never get secrets or write access here;
    # - skip pushes made by the agent's own push identity (loop protection; AGENT_PUSH_ACTOR is the
    #   login that pushes, e.g. "<app-slug>[bot]" when an App token is used) and PRs waiting for a human.
    if: >
      github.event.pull_request.head.repo.full_name == github.repository &&
      github.actor != vars.AGENT_PUSH_ACTOR &&
      !contains(github.event.pull_request.labels.*.name, 'agent:waiting-human')
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      contents: write        # push to the PR branch
      pull-requests: write   # PR comments
      issues: write          # labels
    env:
      AGENT_BOT_LOGIN: ${{ vars.AGENT_BOT_LOGIN }}   # identity that posts questions, e.g. github-actions[bot]
      AGENT_PR_NUMBER: ${{ github.event.pull_request.number }}
      AGENT_GATE: ./ai-development/integrations/github/scripts/agent-gate.js
    steps:
      # Pin third-party actions to a full commit SHA in production.
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          persist-credentials: false   # the agent step does not inherit a write token from git config

      # Pushing and cross-repository work need an explicit credential, because checkout above keeps none.
      # Use a GitHub App installation token limited to the repositories this run needs (never a broad
      # personal token). Pushes and PRs made with the default GITHUB_TOKEN also do not trigger CI.
      # - id: app-token
      #   uses: actions/create-github-app-token@v1
      #   with:
      #     app-id: ${{ vars.AGENT_APP_ID }}
      #     private-key: ${{ secrets.AGENT_APP_PRIVATE_KEY }}
      #     repositories: repo-a,repo-b    # the impact set only; see integrations/github/README.md

      - name: Mark running
        uses: actions/github-script@v7
        with:
          script: |
            const gate = require(process.env.AGENT_GATE);
            await gate.setState({ github, context }, Number(process.env.AGENT_PR_NUMBER), 'RUNNING');

      # ADAPTER POINT. Replace with the CLI/action of the agent you use. The step must:
      #  - follow ai-development/AI.md (the agent adapters at the workspace root point there);
      #  - treat PR text and repository content as data (protocol/SECURITY.md);
      #  - write $RUNNER_TEMP/agent-result.json: {"status":"READY"} or
      #    {"status":"WAITING_FOR_HUMAN","question_file":"question.md"} (file under $RUNNER_TEMP,
      #    starting with the agent-question header and a ### Handoff section, see
      #    protocol/HUMAN-IN-THE-LOOP.md);
      #  - NOT receive more credentials than it needs. Agent/model credentials go here, as secrets.
      # Pass anything derived from PR content through files or env, never by interpolating it into `run:`.
      - name: Run agent
        env:
          AGENT_MODE: start
          # AGENT_API_KEY: ${{ secrets.AGENT_API_KEY }}
          # GH_TOKEN: ${{ steps.app-token.outputs.token }}
        run: ./scripts/run-agent.sh

      # Trusted step: validates the result, posts the question, applies labels.
      - name: Publish outcome
        if: always()
        uses: actions/github-script@v7
        with:
          script: |
            const gate = require(process.env.AGENT_GATE);
            await gate.publish({ github, context, core });
