# OPTIONAL EXAMPLE. Not active until copied to <repository>/.github/workflows/design-pr.yml and adapted.
# Only for repositories that adopted the design source branch model: read integrations/github/README.md,
# "Design-driven repositories", and protocol/DESIGN-DRIVEN.md first.
#
# Flow: builder pushes to the design source branch -> THIS WORKFLOW ensures one open pull request
#       design source branch -> production -> agent-run.yml (gate) starts the agent on that pull request.
#
# This workflow never runs the agent, never checks out or runs code from the design source branch, and never
# pushes. When the design pull request is already open, it does nothing: the builder's push is already a
# `synchronize` event on it, which the gate handles as external intent.
#
# Adjust: the branch names (here, and in the repository variables, which must be set: the script defaults
# studio / main are kept only for earlier setups), the script path, the App.
name: design-pr

on:
  push:
    branches: [main]          # the design source branch: the branch the builder writes to (DESIGN_SOURCE_BRANCH)

# Deny by default; the App token below carries the only write permission.
permissions: {}

# Shared with design-back-sync.yml: one branch operation at a time, never cancelled midway.
concurrency:
  group: design-branch
  cancel-in-progress: false

jobs:
  ensure-pr:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    env:
      DESIGN_SOURCE_BRANCH: ${{ vars.DESIGN_SOURCE_BRANCH }}   # set it, e.g. main (script default: studio)
      PRODUCTION_BRANCH: ${{ vars.PRODUCTION_BRANCH }}         # set it, e.g. production (script default: main)
    steps:
      # The pull request MUST be opened with a GitHub App token. Events caused by the default GITHUB_TOKEN do not
      # start workflows, so agent-run.yml would never see the pull request.
      # Pin third-party actions to a full commit SHA in production.
      - id: app-token
        uses: actions/create-github-app-token@v2
        with:
          app-id: ${{ vars.AGENT_APP_ID }}
          private-key: ${{ secrets.AGENT_APP_PRIVATE_KEY }}
          repositories: ${{ github.event.repository.name }}
          permission-contents: read
          permission-pull-requests: write

      # The script comes from the PRODUCTION branch (reviewed), never from the design source branch the builder
      # writes to: a push there must not be able to change the code that runs with the App token.
      - uses: actions/checkout@v4
        with:
          ref: ${{ vars.PRODUCTION_BRANCH || 'production' }}
          persist-credentials: false
          sparse-checkout: ai-development/integrations/github/scripts

      - uses: actions/github-script@v7
        with:
          github-token: ${{ steps.app-token.outputs.token }}
          script: |
            const design = require('./ai-development/integrations/github/scripts/design-branch.js');
            await design.ensureDesignPr({ github, context, core });
